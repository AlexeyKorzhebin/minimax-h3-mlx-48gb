            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description En"
          },
          "description_ru": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Description Ru",
            "type": "string"
          },
          "expected_revision": {
            "title": "Expected Revision",
            "type": "integer"
          },
