            "anyOf": [
              {
                "maxLength": 400,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portrait Phrase"
          },
          "tag": {
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "title": "Tag",
            "type": "string"
          }
        },
        "required": [
          "expected_revision",
          "tag",
          "description_ru"
        ],
        "title": "CastCreate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
